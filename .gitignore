# --- secrets: never commit a real environment file ---
.env
.env*
*.env
!.env.example

# --- virtual environments ---
.venv/
venv/

# --- python bytecode / build artifacts ---
__pycache__/
*.py[cod]
dist/
build/
*.egg-info/

# --- tool caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- local state and generated output ---
# plan apply state files map local refs to created issue keys
*.applied.json
plans/
reports/
exports/
.scan-out/
# report and plan files written by `jira` when run from the repo root; the
# menu now defaults to ~/.local/share/jira-cli, these catch typed paths.
# Root-anchored on purpose: tests/fixtures/*.json and docs/*.md are tracked.
/*.csv
/*.json
/*report*.md
/*plan*.yaml
/*plan*.yml

# --- Windows download markers (alternate data streams copied from Windows) ---
*:Zone.Identifier
*.Zone.Identifier

# --- local configuration that names real people, projects and boards ---
teams.yaml
filters.yaml
