# jira-cli-manager — environment template
#
# Copy this file to  ~/.config/jira-cli/.env  and set the values you need.
# install.sh does the copy for you and chmods the result to 600.
#
#   cp .env.example ~/.config/jira-cli/.env && chmod 600 ~/.config/jira-cli/.env
#
# Every line below is commented out on purpose: the file as shipped contains
# PLACEHOLDERS ONLY and never a real host, user or token. Uncomment what you
# need and replace the placeholder.
#
# Lookup order for the environment file (the first one that applies is used):
#   1. --env-file FILE                  (explicit CLI flag; must exist)
#   2. $JIRA_CLI_ENV_FILE               (process environment only)
#   3. <config_dir>/.env                (default ~/.config/jira-cli/.env)
#   4. ~/.jira-cli/config.env           (legacy 1.x location, if it exists)
# Values already present in the process environment always win over the file.
#
# Syntax: KEY=VALUE, one per line. An optional leading "export " is allowed,
# quotes are honoured, " #" starts a trailing comment on an unquoted value,
# and there is NO shell expansion — write literal values, not $OTHER_VAR.
# The tool warns on stderr if this file is readable by other users.


# ---------------------------------------------------------------------------
# Connection (required)
# ---------------------------------------------------------------------------

# Base URL of your Jira Server / Data Center instance. Must start with
# http:// or https://. A trailing slash is stripped.
#JIRA_BASE_URL=https://jira.example.com


# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# "pat"   -> Personal Access Token sent as a Bearer token (recommended)
# "basic" -> HTTP Basic with username + password
# Default: "pat" when JIRA_PAT is set, otherwise "basic".
#JIRA_AUTH_MODE=pat

# Personal Access Token. Create it in Jira:
#   avatar (top right) -> Profile -> Personal Access Tokens -> Create token
# See README.md for the full walkthrough. Treat it like a password.
#JIRA_PAT=replace-with-your-personal-access-token

# Your Jira *username* (Jira Server identifies users by username, not email).
# Required for basic auth; optional in pat mode, where /myself resolves it.
#JIRA_USERNAME=alice

# Password, used only when JIRA_AUTH_MODE=basic. Prefer a PAT instead.
#JIRA_PASSWORD=replace-with-your-password


# ---------------------------------------------------------------------------
# Defaults and behaviour
# ---------------------------------------------------------------------------

# Project key assumed when a command does not name one (upper-cased).
#JIRA_DEFAULT_PROJECT=PROJ

# TLS verification. "1"/"true" (default, keep it), "0"/"false" to disable
# (strongly discouraged), or a path to a CA bundle for a private CA.
#JIRA_VERIFY_TLS=1

# Per-request timeout in seconds. Default 20.
#JIRA_TIMEOUT=20

# "1" refuses every write (create, edit, transition, worklog, delete, ...) in
# both the CLI and the MCP server. Recommended while you are getting your
# bearings. Accepts 1/0, true/false, yes/no, on/off.
#JIRA_READ_ONLY=0

# Working-time calendar used to convert "1d" / "1w". Defaults 8 and 5.
#JIRA_HOURS_PER_DAY=8
#JIRA_DAYS_PER_WEEK=5

# Directory holding teams.yaml, filters.yaml and (by default) .env.
# Default ~/.config/jira-cli. Set it in the process environment if you also
# want the .env lookup to move there.
#JIRA_CONFIG_DIR=/home/alice/.config/jira-cli


# ---------------------------------------------------------------------------
# Custom field overrides (optional)
# ---------------------------------------------------------------------------
# Custom field ids differ per Jira instance. They are discovered by display
# name at runtime; set these only when discovery picks the wrong field.

#JIRA_FIELD_SPRINT=customfield_10000
#JIRA_FIELD_EPIC_LINK=customfield_10001
#JIRA_FIELD_EPIC_NAME=customfield_10002
#JIRA_FIELD_STORY_POINTS=customfield_10003


# ---------------------------------------------------------------------------
# Legacy aliases (read only when the modern name above is absent)
# ---------------------------------------------------------------------------
# Kept so a 1.x config keeps working. Prefer the modern names.

#JIRA_EMAIL=alice                 # -> JIRA_USERNAME
#JIRA_API_TOKEN=replace-me        # -> JIRA_PASSWORD (basic auth)
#JIRA_PROJECT=PROJ                # -> JIRA_DEFAULT_PROJECT


# ---------------------------------------------------------------------------
# Process-environment only (not read from this file)
# ---------------------------------------------------------------------------
# These are looked up in the shell environment, so setting them here has no
# effect. Listed for completeness.
#
#   JIRA_CLI_ENV_FILE=/home/alice/.config/jira-cli/admin.env   # pick an env file
#   JIRA_CLI_DEBUG=1                                           # tracebacks, like --debug
#   NO_COLOR=1                                                 # disable ANSI colour
